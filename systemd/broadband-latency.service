[Unit]
Description=Broadband latency/DNS/HTTP probe sweep
Documentation=https://github.com/mmorrow24work/home-broadband
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=broadband
Group=broadband
WorkingDirectory=/opt/broadband-monitor
Environment=BROADBAND_CONFIG=/etc/broadband-monitor/config.yaml
ExecStart=/opt/broadband-monitor/.venv/bin/python -m collector.main latency
TimeoutStartSec=55
Nice=5

# Unprivileged ICMP relies on net.ipv4.ping_group_range covering this group
# (install.sh writes the sysctl drop-in). If your kernel disallows it, drop the
# sysctl and uncomment the next two lines instead.
#AmbientCapabilities=CAP_NET_RAW
#CapabilityBoundingSet=CAP_NET_RAW

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/broadband-monitor
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
